rules_version = '2';
// Deny by default. Users may read and write only inside their own folder:
//   users/{uid}/...  (pet photos, vault files, album media, chat attachments)
// Partners' public photos live under public/{uid}/ and are readable by any signed-in user.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }
    match /public/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
