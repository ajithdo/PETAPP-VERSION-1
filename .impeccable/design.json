 "narrative": {
  "northStar": "The pet's day, made into a small daily ritual",
  "overview": "Genda is the marigold garland of an Indian home. In the app it appears once, where it matters: around the selected pet's photo on Home, one flower per task today, opening as each is done. Everything else is quiet: cocoa ink on white and warm-grey grounds, soft rounded cards, plain words.\n\nTwo registers share one system. The warm register (Home, empty states, onboarding, album) may fill shapes with marigold and use big Baloo titles. The calm register (Health, records, tele-vet, SOS, portals) has no marigold fills, green 'given' ticks and compact tables. SOS red is the only red.",
  "keyCharacteristics": [
   "Cocoa action colour, marigold only as fill",
   "Baloo titles and Hind text in English, Hindi and Telugu",
   "22 px cards with one soft warm shadow",
   "Date blocks lead every scheduled row",
   "One filled action per screen; at most one chip per row"
  ],
  "rules": [
   {
    "name": "The One Red Rule",
    "body": "SOS red means an emergency, nothing else.",
    "section": "colors"
   },
   {
    "name": "The Marigold Is Not Ink Rule",
    "body": "Marigold fills shapes; it is never text on a light ground.",
    "section": "colors"
   },
   {
    "name": "The 13 Rule",
    "body": "No text under 13 px.",
    "section": "typography"
   },
   {
    "name": "The Indic Rule",
    "body": "Hindi and Telugu: line height 1.6+, never letter-spaced or upper-cased, small text one step up.",
    "section": "typography"
   },
   {
    "name": "The One Shadow Rule",
    "body": "Cards have one shadow recipe; elevation never decorates.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Lead with the selected pet and what it needs now",
   "Use the calm register on Health, records, tele-vet, SOS and portals",
   "Show a price and a discount once"
  ],
  "donts": [
   "Don't use red, coral or orange-red outside emergencies",
   "Don't put a small label above a heading",
   "Don't repeat a label on every row"
  ]
 }
