  "toxChocolateName": "चॉकलेट",
  "toxChocolateWhy": "इसमें थियोब्रोमीन और कैफ़ीन होते हैं, जिनसे उल्टी, तेज़ धड़कन और दौरे हो सकते हैं। डार्क चॉकलेट और कोको पाउडर सबसे ख़तरनाक हैं।",
  "toxGrapesName": "अंगूर और किशमिश",
  "toxGrapesWhy": "थोड़े से अंगूर या किशमिश भी कुत्तों और बिल्लियों में अचानक किडनी फ़ेल कर सकते हैं। पक्षी और खरगोश: कभी-कभार सिर्फ़ छोटा टुकड़ा।",
  "toxOnionGarlicName": "प्याज़ और लहसुन",
  "toxOnionGarlicWhy": "कच्चे, पके या पाउडर, करी और ग्रेवी में भी, ये ख़ून की लाल कोशिकाओं को नुकसान पहुँचाते हैं और कुछ दिन बाद कमज़ोरी आती है।",
  "toxXylitolName": "ज़ाइलिटॉल (शुगर-फ़्री मिठास)",
  "toxXylitolWhy": "शुगर-फ़्री च्युइंग गम, मिंट, कुछ पीनट बटर और दवाओं में होता है। कुत्तों में इससे अचानक ब्लड शुगर गिरती है और लिवर ख़राब होता है। इसे सभी पालतुओं से दूर रखें।",
  "toxAlcoholName": "शराब",
  "toxAlcoholWhy": "थोड़ी सी मात्रा से भी उल्टी, लड़खड़ाहट, साँस की तकलीफ़ और बेहोशी हो सकती है। ख़मीर वाला कच्चा आटा भी पेट में शराब बनाता है।",
  "toxCaffeineName": "चाय, कॉफ़ी और कैफ़ीन",
  "toxCaffeineWhy": "चाय, कॉफ़ी, एनर्जी ड्रिंक और कैफ़ीन की गोलियों से बेचैनी, तेज़ धड़कन और दौरे हो सकते हैं।",
  "toxAvocadoName": "एवोकाडो",
  "toxAvocadoWhy": "पक्षियों और खरगोशों के लिए बहुत ख़तरनाक: दिल को नुकसान पहुँचा सकता है। कुत्तों और बिल्लियों में गुठली आँतों में फँस सकती है, और छिलका व पत्ते पेट ख़राब करते हैं।",
  "toxCookedBonesName": "पकी हुई हड्डियाँ",
  "toxCookedBonesWhy": "पकी हुई चिकन या मटन की हड्डियाँ टूटकर नुकीली हो जाती हैं और गले में फँस सकती हैं या आँतें फाड़ सकती हैं। पकी हड्डियाँ कभी न दें।",
  "toxMilkName": "दूध",
  "toxMilkWhy": "ज़्यादातर बड़ी बिल्लियाँ और कुत्ते दूध ठीक से नहीं पचा पाते और उन्हें दस्त हो जाते हैं। पक्षियों और खरगोशों को दूध न दें।",
  "toxSaltySnacksName": "नमकीन स्नैक्स (नमकीन, चिप्स)",
  "toxSaltySnacksWhy": "नमकीन, चिप्स और पापड़ से प्यास और उल्टी होती है; ज़्यादा खाने पर नमक का ज़हर चढ़ सकता है। पक्षी इसके लिए ख़ास तौर पर संवेदनशील हैं।",
  "toxSpicyFoodName": "मसालेदार खाना",
  "toxSpicyFoodWhy": "मिर्च और मसाले पेट ख़राब करते हैं, उल्टी और दस्त होते हैं। करी में अक्सर प्याज़ और लहसुन भी होते हैं।",
  "toxFattyFoodName": "तला और चिकनाई वाला खाना",
  "toxFattyFoodWhy": "तले हुए स्नैक्स, घी, चर्बी और भारी बचा हुआ खाना पैंक्रियाटाइटिस कर सकता है, जो अग्न्याशय की दर्दनाक सूजन है।",
  "toxSweetsName": "मिठाई",
  "toxSweetsWhy": "मीठी मिठाइयों से वज़न बढ़ता है और पेट ख़राब होता है, और कई में घी, चॉकलेट, किशमिश या शुगर-फ़्री मिठास होती है।",
  "toxFruitSeedsName": "फलों की गुठली और बीज",
  "toxFruitSeedsWhy": "आम की गुठली, सेब के बीज और आलूबुखारा, आड़ू, चेरी की गुठलियाँ गले या आँतों में फँस सकती हैं, और कुछ में साइनाइड होता है।",
  "toxTomatoName": "टमाटर",
  "toxTomatoWhy": "थोड़ा पका टमाटर आमतौर पर ठीक है। हरे टमाटर, पत्ते और डंठल नुकसानदायक हैं।",
  "toxPeanutsName": "मूँगफली",
  "toxPeanutsWhy": "सिर्फ़ सादी, बिना नमक की मूँगफली, एक बार में कुछ ही। नमकीन या मसाला मूँगफली सुरक्षित नहीं है, और पीनट बटर में ज़ाइलिटॉल नहीं होना चाहिए।",
  "toxMangoName": "आम",
  "toxMangoWhy": "पके आम का गूदा छोटे ट्रीट के रूप में ठीक है। छिलका और गुठली हटा दें। ज़्यादा खाने से दस्त होते हैं।",
  "toxAppleName": "सेब",
  "toxAppleWhy": "बीज और बीच का हिस्सा हटाकर सेब के टुकड़े एक सेहतमंद, कुरकुरा ट्रीट हैं।",
  "toxBananaName": "केला",
  "toxBananaWhy": "छोटा टुकड़ा अच्छा ट्रीट है। इसमें शक्कर ज़्यादा होती है, इसलिए थोड़ा ही दें।",
  "toxWatermelonName": "तरबूज़",
  "toxWatermelonWhy": "बिना बीज और छिलके के टुकड़े गर्मियों का ठंडा ट्रीट हैं।",
  "toxCarrotName": "गाजर",
  "toxCarrotWhy": "कच्ची या पकी गाजर सेहतमंद ट्रीट है। खरगोशों को गाजर थोड़ी ही दें, क्योंकि इसमें शक्कर होती है।",
  "toxRiceName": "सादे पके चावल",
  "toxRiceWhy": "बिना नमक, घी, प्याज़ या मसाले के सादे चावल थोड़ी मात्रा में पेट के लिए हल्के हैं। खरगोशों को चावल नहीं, सूखी घास चाहिए।",
  "toxEggName": "पका हुआ अंडा",
  "toxEggWhy": "पूरी तरह पका अंडा प्रोटीन वाला अच्छा ट्रीट है। कच्चा अंडा न दें। खरगोश सिर्फ़ पौधे खाते हैं।",
  "toxLilyName": "लिली",
  "toxLilyWhy": "लिली का हर हिस्सा, यहाँ तक कि पराग या फूलदान का पानी भी, बिल्लियों में किडनी फ़ेल कर सकता है। बिल्ली वाले घर में लिली न रखें।",
  "toxSagoPalmName": "साइकस (सागो पाम)",
  "toxSagoPalmWhy": "हर हिस्सा ज़हरीला है, बीज सबसे ज़्यादा। इससे उल्टी और लिवर फ़ेल हो सकता है।",
  "toxOleanderName": "कनेर",
  "toxOleanderWhy": "कनेर दिल पर असर करता है। कुछ पत्ते या फूल भी जानलेवा हो सकते हैं।",
  "toxCastorName": "अरंडी",
  "toxCastorWhy": "अरंडी के बीजों में रिसिन होता है। एक-दो बीज चबाना भी जानलेवा हो सकता है।",
  "toxDaturaName": "धतूरा",
  "toxDaturaWhy": "इसके बीज और फूल से तेज़ धड़कन, फैली पुतलियाँ, बेचैनी और दौरे होते हैं।",
  "toxLantanaName": "लैंटाना",
  "toxLantanaWhy": "इस आम झाड़ी के बेर और पत्ते लिवर को नुकसान पहुँचा सकते हैं।",
  "toxAloeVeraName": "एलोवेरा",
  "toxAloeVeraWhy": "पारदर्शी जेल आमतौर पर ठीक है, लेकिन छिलके के नीचे का कड़वा पीला रस उल्टी और दस्त करता है।",
  "toxMoneyPlantName": "मनी प्लांट",
  "toxMoneyPlantWhy": "पत्ते चबाने से मुँह में दर्द, लार गिरना और उल्टी होती है।",
  "toxSnakePlantName": "स्नेक प्लांट",
  "toxSnakePlantWhy": "इसे चबाने से लार गिरना, उल्टी और दस्त हो सकते हैं।",
  "toxMarigoldName": "गेंदा",
  "toxMarigoldWhy": "गेंदे के फूल चबाने से मुँह में हल्की जलन और पेट ख़राब हो सकता है।",
  "toxTulsiName": "तुलसी",
  "toxTulsiWhy": "तुलसी पालतुओं के लिए ज़हरीली नहीं मानी जाती। फिर भी ज़्यादा खाने से पेट ख़राब हो सकता है।",
  "toxArecaPalmName": "एरिका पाम",
  "toxArecaPalmWhy": "पालतुओं के लिए सुरक्षित घरेलू पौधा।",
  "toxSpiderPlantName": "स्पाइडर प्लांट",
  "toxSpiderPlantWhy": "ज़हरीला नहीं है, हालाँकि बिल्लियाँ इसे चबाना पसंद करती हैं और थोड़ी उल्टी कर सकती हैं।",
  "toxRatPoisonName": "चूहे मारने की दवा",
