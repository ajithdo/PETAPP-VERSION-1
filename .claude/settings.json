{
  "permissions": {
    "allow": [
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter pub get *)",
      "Bash(flutter gen-l10n *)",
      "Bash(flutter build web *)",
      "Bash(dart format *)",
      "Bash(dart run build_runner *)",
      "Bash(dart run tools/l10n/merge.dart *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "mcp__dart__*"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(firebase deploy *)",
      "Bash(npx *firebase-tools* deploy *)",
      "Bash(netlify deploy *)",
      "Bash(npx *netlify* deploy *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(find * -delete *)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
